diff --git a/fox_fifo/fox_channel.cpp b/fox_fifo/fox_channel.cpp
index d17c403..b862fed 100644
--- a/fox_fifo/fox_channel.cpp
+++ b/fox_fifo/fox_channel.cpp
@@ -30,6 +30,38 @@ namespace {
 int g_input_fd = -1;
 int g_cancel_fd = -1;
 
+// A CLI writes foxin before opening foxout. Allow a short scheduling window,
+// but never block the GUI indefinitely if that client has already disappeared.
+FILE* open_output_fifo()
+{
+	const int attempts = 50;
+	for (int attempt = 0; attempt < attempts; ++attempt) {
+		int fd = open(FOX_OUTPUT_FILE, O_WRONLY | O_NONBLOCK | O_CLOEXEC);
+		if (fd >= 0) {
+			struct stat info;
+			if (fstat(fd, &info) != 0 || !S_ISFIFO(info.st_mode)) {
+				close(fd);
+				return nullptr;
+			}
+			int flags = fcntl(fd, F_GETFL);
+			if (flags < 0 || fcntl(fd, F_SETFL, flags & ~O_NONBLOCK) != 0) {
+				close(fd);
+				return nullptr;
+			}
+			// Keep ordinary buffered writes for complete, possibly large PNG replies.
+			FILE* out = fdopen(fd, "w");
+			if (!out)
+				close(fd);
+			return out;
+		}
+		if (errno != ENXIO && errno != EINTR)
+			return nullptr;
+		if (attempt + 1 < attempts)
+			usleep(10000);
+	}
+	return nullptr;
+}
+
 void setup_command_fifo()
 {
 	g_input_fd = -1;
