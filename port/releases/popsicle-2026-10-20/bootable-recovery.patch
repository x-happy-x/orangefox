-		LOGINFO("Unable to fopen %s\n", FOX_OUTPUT_FILE);
-		unlink(FOX_INPUT_FILE);
-		unlink(FOX_OUTPUT_FILE);
+		LOGINFO("Fox output reader unavailable; dropping request\n");
+		RearmInput();
 		return;
 	}
 	if (!request.ok()) {
diff --git a/gui/action.cpp b/gui/action.cpp
index bd5da25..17e61ca 100644
--- a/gui/action.cpp
+++ b/gui/action.cpp
@@ -3032,13 +3032,89 @@ int GUIAction::unmapsuperdevices(std::string arg __unused) {
 
 #ifdef OF_USE_NANO_EDITOR
 int GUIAction::editfile(std::string arg) {
-	if (term != NULL) {
-		for (uint8_t iter = 0; iter < arg.size(); iter++)
-			term->NotifyCharInput(arg.at(iter));
-		term->NotifyCharInput(13);
-	}
-	else
+	if (term == NULL) {
 		LOGINFO("Unable to switch to Terminal\n");
+		return 1;
+	}
+	if (term->status()) {
+		gui_err("nano_terminal_busy=Close the current terminal session before opening a file in nano.");
+		return 1;
+	}
+	if (arg.empty()) {
+		gui_err("file_read_error=Unable to open file!");
+		return 1;
+	}
+
+	// Pass one literal filename to the shell, including spaces and quotes.
+	std::string command = "exec /system/bin/nano -- '";
+	for (unsigned char ch : arg) {
+		// Interactive terminal control bytes must never become part of a command.
+		if (ch < 0x20 || ch == 0x7f) {
+			gui_err("file_read_error=Unable to open file!");
+			return 1;
+		}
+		if (ch == '\'')
+			command += "'\\''";
+		else
+			command += static_cast<char>(ch);
+	}
+	command += "'";
+
+	// Decode and validate the complete UTF-8 command before sending any input.
+	// Android builds this module with -fno-exceptions.
+	std::wstring input;
+	for (size_t offset = 0; offset < command.size();) {
+		unsigned char lead = static_cast<unsigned char>(command[offset]);
+		unsigned int codepoint;
+		unsigned int minimum;
+		size_t length;
+		if (lead < 0x80) {
+			codepoint = lead;
+			minimum = 0;
+			length = 1;
+		} else if (lead >= 0xc2 && lead <= 0xdf) {
+			codepoint = lead & 0x1f;
+			minimum = 0x80;
+			length = 2;
+		} else if (lead >= 0xe0 && lead <= 0xef) {
+			codepoint = lead & 0x0f;
+			minimum = 0x800;
+			length = 3;
+		} else if (lead >= 0xf0 && lead <= 0xf4) {
+			codepoint = lead & 0x07;
+			minimum = 0x10000;
+			length = 4;
+		} else {
+			gui_err("file_read_error=Unable to open file!");
+			return 1;
+		}
+		if (length > command.size() - offset) {
+			gui_err("file_read_error=Unable to open file!");
+			return 1;
+		}
+		for (size_t index = 1; index < length; ++index) {
+			unsigned char next = static_cast<unsigned char>(command[offset + index]);
+			if (next < 0x80 || next > 0xbf) {
+				gui_err("file_read_error=Unable to open file!");
+				return 1;
+			}
+			codepoint = (codepoint << 6) | (next & 0x3f);
+		}
+		if (codepoint < minimum || codepoint > 0x10ffff ||
+		    (codepoint >= 0xd800 && codepoint <= 0xdfff) ||
+		    codepoint < 0x20 || (codepoint >= 0x7f && codepoint <= 0x9f)) {
+			gui_err("file_read_error=Unable to open file!");
+			return 1;
+		}
+		input.push_back(static_cast<wchar_t>(codepoint));
+		offset += length;
+	}
+	// A fresh editor replaces its shell; Ctrl+X closes this PTY instead of leaving it active.
+	DataManager::SetValue("tw_terminal_location", "");
+	DataManager::SetValue("tw_hide_kb", 0);
+	for (wchar_t ch : input)
+		term->NotifyCharInput(ch);
+	term->NotifyCharInput(13);
 	return 0;
 }
 #endif
